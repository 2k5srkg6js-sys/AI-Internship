# Template only. Do NOT put real values here and do NOT create a .env in week-3.
# Copy this file to ai-engineering-bootcamp-v2/week-1/.env (git-ignored) and fill it in;
# week-3/agent/tools.py loads that file.

# Gemini (Google AI Studio) for the ADK agent
GOOGLE_API_KEY=your-google-api-key

# Query embeddings (text-embedding-3-small) used by week-1/rag.py
OPENAI_API_KEY=your-openai-api-key

# Existing Pinecone index: dense, dimension 1536, metric cosine
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=your-index-name
# Optional: leave empty for the default namespace
PINECONE_NAMESPACE=

# Optional: override the Gemini model (default gemini-2.5-flash)
# AGENT_MODEL=gemini-2.5-flash
