# Required: copy this file to .env and fill in real values locally.
# On Render, set the same variables in the service's Environment settings.
OPENAI_API_KEY=
PINECONE_API_KEY=
# Name of an EXISTING Pinecone index: dense, dimension 1536, metric cosine.
PINECONE_INDEX_NAME=

# Optional: leave empty to use Pinecone's default namespace.
PINECONE_NAMESPACE=

# Required for live POST /ingest: callers must send this value in the X-Ingest-Token
# header. Use a long random string. If unset, /ingest is disabled (HTTP 503).
INGEST_DEMO_TOKEN=

# Streamlit UI (streamlit_app.py): base URL of the FastAPI service, e.g. your Render URL.
API_BASE_URL=https://your-service.onrender.com
